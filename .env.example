# Copy this file to `.env` and fill in every __REPLACE_ME_*__ placeholder before running.
# Never commit the real `.env` file - it is git-ignored (see CLAUDE.md §5).

# --- Database ---
# Used directly by the API/Worker when running outside Docker (e.g. `dotnet run`).
DB_CONNECTION_STRING=Server=localhost,1433;Database=210044;User Id=sa;Password=__REPLACE_ME_DB_SA_PASSWORD__;TrustServerCertificate=True
# Used by docker-compose to provision the SQL Server container AND to build the in-container
# connection string (see docker-compose.yml) - keep this equal to the password above.
DB_SA_PASSWORD=__REPLACE_ME_DB_SA_PASSWORD__

# --- JWT ---
JWT_KEY=__REPLACE_ME_JWT_KEY__
JWT_ISSUER=eAutoskola
JWT_AUDIENCE=eAutoskola.Client
JWT_EXPIRY_MINUTES=60

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=__REPLACE_ME_RABBITMQ_USER__
RABBITMQ_PASSWORD=__REPLACE_ME_RABBITMQ_PASSWORD__

# --- SMTP ---
# Point at the local mailhog catcher for development (docker-compose overrides these three for
# the `worker` service automatically); set real provider credentials for anything beyond local
# dev/review.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=__REPLACE_ME_SMTP_USERNAME__
SMTP_PASSWORD=__REPLACE_ME_SMTP_PASSWORD__
SMTP_USE_SSL=false
SMTP_FROM=noreply@eautoskola.ba

# --- PayPal (sandbox) ---
PAYPAL_CLIENT_ID=__REPLACE_ME_PAYPAL_CLIENT_ID__
PAYPAL_CLIENT_SECRET=__REPLACE_ME_PAYPAL_CLIENT_SECRET__
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=__REPLACE_ME_PAYPAL_WEBHOOK_ID__
PAYPAL_RETURN_URL=http://localhost:5000/api/payment/paypal/return
PAYPAL_CANCEL_URL=http://localhost:5000/api/payment/paypal/cancel

# --- API / CORS ---
# Consumed by Flutter at build/run time via --dart-define=API_BASE_URL=... (not read by the
# backend itself - documented here so every config value lives in one place per upute.md §3.3).
API_BASE_URL=http://10.0.2.2:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Development
